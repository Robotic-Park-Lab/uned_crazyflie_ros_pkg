<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uned_crazyflie_config</name>
  <version>0.0.0</version>
  <description>Configuración, lanzamiento y mensajes/servicios personalizados para el crazyflie 2.1</description>
  <maintainer email="fjmanas@dia.uned.es">Francisco José Mañas Álvarez</maintainer>
  <author email="fjmanas@dia.uned.es">Francisco José Mañas Álvarez</author>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>

  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <!-- launch/experience.launch.py (tarea 8, ver AUDIT.md rama doc) importa
       estos dos de verdad. NO se declaran aquí uned_crazyflie_driver,
       uned_crazyflie_webots, uned_crazyflie_gui ni uned_crazyflie_missions
       (a los que el launch solo se refiere por nombre de paquete en
       Node(package=...), en tiempo de ejecución, igual que ya hacían los
       .launch.py anteriores): esos 3 paquetes ya dependen de este
       (uned_crazyflie_config, por sus mensajes propios), así que declarar
       la dependencia inversa aquí crea un ciclo real que colcon no puede
       ordenar. Comprobado con un colcon build real. -->
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>webots_ros2_driver</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
 </package>
